{
  "name": "Main Flow",
  "description": "Entry point for Resend AI Agent",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "next": "welcome"
    },
    {
      "id": "welcome",
      "type": "speak",
      "messages": [
        "👋 Welcome to Resend AI Agent! I can help you send emails, check delivery status, manage domains, contacts, templates, audiences, send batch emails, view analytics, process webhooks, and even talk via voice. What would you like to do?"
      ],
      "next": "listen"
    },
    {
      "id": "listen",
      "type": "intent",
      "intents": ["send_email", "check_email_status", "list_emails", "verify_domain", "manage_contacts", "manage_templates", "manage_audiences", "send_batch", "analytics", "voice", "webhook_events", "help"],
      "capture": {
        "send_email": "send_email_flow",
        "check_email_status": "check_status_flow",
        "list_emails": "list_emails_flow",
        "verify_domain": "verify_domain_flow",
        "manage_contacts": "manage_contacts_flow",
        "manage_templates": "manage_templates_flow",
        "manage_audiences": "manage_audiences_flow",
        "send_batch": "send_batch_flow",
        "analytics": "analytics_flow",
        "voice": "voice_flow",
        "run_ab_test": "run_ab_test_flow",
        "schedule_campaign": "schedule_campaign_flow",
        "manage_tenants": "manage_tenants_flow",
        "manage_workspaces": "manage_workspaces_flow",
        "analytics_dashboard": "analytics_dashboard_flow",
        "manage_whitelabel": "manage_whitelabel_flow",
        "webhook_events": "webhook_events_flow",
        "help": "help_flow"
      },
      "fallback": "fallback_flow"
    },
    {
      "id": "send_email_flow",
      "type": "flow",
      "flow": "send_email",
      "next": "continue_prompt"
    },
    {
      "id": "check_status_flow",
      "type": "flow",
      "flow": "check_email_status",
      "next": "continue_prompt"
    },
    {
      "id": "list_emails_flow",
      "type": "flow",
      "flow": "list_emails",
      "next": "continue_prompt"
    },
    {
      "id": "verify_domain_flow",
      "type": "flow",
      "flow": "verify_domain",
      "next": "continue_prompt"
    },
    {
      "id": "manage_contacts_flow",
      "type": "flow",
      "flow": "manage_contacts",
      "next": "continue_prompt"
    },
    {
      "id": "manage_templates_flow",
      "type": "flow",
      "flow": "manage_templates",
      "next": "continue_prompt"
    },
    {
      "id": "manage_audiences_flow",
      "type": "flow",
      "flow": "manage_audiences",
      "next": "continue_prompt"
    },
    {
      "id": "send_batch_flow",
      "type": "flow",
      "flow": "send_batch",
      "next": "continue_prompt"
    },
    {
      "id": "analytics_flow",
      "type": "flow",
      "flow": "analytics",
      "next": "continue_prompt"
    },
    {
      "id": "voice_flow",
      "type": "flow",
      "flow": "voice",
      "next": "end"
    },
    {
      "id": "run_ab_test_flow",
      "type": "flow",
      "flow": "run_ab_test",
      "next": "continue_prompt"
    },
    {
      "id": "schedule_campaign_flow",
      "type": "flow",
      "flow": "schedule_campaign",
      "next": "continue_prompt"
    },
    {
      "id": "manage_tenants_flow",
      "type": "flow",
      "flow": "manage_tenants",
      "next": "continue_prompt"
    },
    {
      "id": "manage_workspaces_flow",
      "type": "flow",
      "flow": "manage_workspaces",
      "next": "continue_prompt"
    },
    {
      "id": "analytics_dashboard_flow",
      "type": "flow",
      "flow": "analytics_dashboard",
      "next": "continue_prompt"
    },
    {
      "id": "manage_whitelabel_flow",
      "type": "flow",
      "flow": "manage_whitelabel",
      "next": "continue_prompt"
    },
    {
      "id": "webhook_events_flow",
      "type": "flow",
      "flow": "webhook_events",
      "next": "continue_prompt"
    },
    {
      "id": "help_flow",
      "type": "flow",
      "flow": "help",
      "next": "continue_prompt"
    },
    {
      "id": "fallback_flow",
      "type": "flow",
      "flow": "fallback",
      "next": "listen"
    },
    {
      "id": "continue_prompt",
      "type": "choice",
      "message": "What else can I help you with?",
      "buttons": [
        { "label": "Send email", "value": "send_email" },
        { "label": "Check email status", "value": "check_email_status" },
        { "label": "List emails", "value": "list_emails" },
        { "label": "Verify domain", "value": "verify_domain" },
        { "label": "Manage contacts", "value": "manage_contacts" },
        { "label": "Manage templates", "value": "manage_templates" },
        { "label": "Manage audiences", "value": "manage_audiences" },
        { "label": "Send batch", "value": "send_batch" },
        { "label": "View analytics", "value": "analytics" },
        { "label": "Voice mode", "value": "voice" },
        { "label": "Run A/B test", "value": "run_ab_test" },
        { "label": "Schedule campaign", "value": "schedule_campaign" },
        { "label": "Manage tenants", "value": "manage_tenants" },
        { "label": "Manage workspaces", "value": "manage_workspaces" },
        { "label": "Analytics dashboard", "value": "analytics_dashboard" },
        { "label": "White-label", "value": "manage_whitelabel" },
        { "label": "Webhook events", "value": "webhook_events" },
        { "label": "Help", "value": "help" },
        { "label": "Done", "value": "done" }
      ],
      "next": "route_continue"
    },
    {
      "id": "route_continue",
      "type": "condition",
      "conditions": [
        { "field": "value", "operator": "equals", "value": "send_email", "next": "send_email_flow" },
        { "field": "value", "operator": "equals", "value": "check_email_status", "next": "check_status_flow" },
        { "field": "value", "operator": "equals", "value": "list_emails", "next": "list_emails_flow" },
        { "field": "value", "operator": "equals", "value": "verify_domain", "next": "verify_domain_flow" },
        { "field": "value", "operator": "equals", "value": "manage_contacts", "next": "manage_contacts_flow" },
        { "field": "value", "operator": "equals", "value": "manage_templates", "next": "manage_templates_flow" },
        { "field": "value", "operator": "equals", "value": "manage_audiences", "next": "manage_audiences_flow" },
        { "field": "value", "operator": "equals", "value": "send_batch", "next": "send_batch_flow" },
        { "field": "value", "operator": "equals", "value": "analytics", "next": "analytics_flow" },
        { "field": "value", "operator": "equals", "value": "voice", "next": "voice_flow" },
        { "field": "value", "operator": "equals", "value": "run_ab_test", "next": "run_ab_test_flow" },
        { "field": "value", "operator": "equals", "value": "schedule_campaign", "next": "schedule_campaign_flow" },
        { "field": "value", "operator": "equals", "value": "manage_tenants", "next": "manage_tenants_flow" },
        { "field": "value", "operator": "equals", "value": "manage_workspaces", "next": "manage_workspaces_flow" },
        { "field": "value", "operator": "equals", "value": "analytics_dashboard", "next": "analytics_dashboard_flow" },
        { "field": "value", "operator": "equals", "value": "manage_whitelabel", "next": "manage_whitelabel_flow" },
        { "field": "value", "operator": "equals", "value": "webhook_events", "next": "webhook_events_flow" },
        { "field": "value", "operator": "equals", "value": "help", "next": "help_flow" }
      ],
      "defaultNext": "goodbye"
    },
    {
      "id": "goodbye",
      "type": "speak",
      "messages": ["👋 Thanks for using Resend AI Agent! Have a great day!"],
      "next": "end"
    },
    {
      "id": "end",
      "type": "end"
    }
  ]
}
